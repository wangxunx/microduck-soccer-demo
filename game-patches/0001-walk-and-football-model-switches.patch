new file mode 100644
index 0000000..fe74a39
--- /dev/null
+++ b/src/physics/stand-policy.js
@@ -0,0 +1,20 @@
+// Selectable get-up / standing policy (URL ?stand=<key>). Whitelisted: no arbitrary paths.
+// Used for fall recovery and the one-second balance after a learned kick.
+// All variants keep the 61D obs / 14D action / 50 Hz contract of BEST_alpha_stand.onnx.
+// Genesis variants were trained on AMD GPUs (microduck-soccer-demo/training, see MODELS.md).
+export const STAND_POLICIES = {
+  official: { file: "BEST_alpha_stand.onnx", label: "官方 Pollen (mjlab)" },
+  // stand-B: upstream stand-up recipe ported to Genesis + random-drop / kick-end starts
+  // (training/train_standup.py). Recovers from every S6 get-up case, also after walk-A.
+  genesis: { file: "genesis/stand-B-9999.onnx", label: "Genesis stand-B" },
+};
+export const DEFAULT_STAND = "official";
+export function resolveStandPolicy(key) {
+  const k = key || DEFAULT_STAND;
+  const policy = STAND_POLICIES[k];
+  if (!policy)
+    throw new Error(
+      `未知的起身模型 stand=${k}，可选：${Object.keys(STAND_POLICIES).join(", ")}`,
+    );
+  return { key: k, ...policy };
+}
diff --git a/src/physics/walk-policy.js b/src/physics/walk-policy.js
new file mode 100644
index 0000000..8dd0a60
--- /dev/null
+++ b/src/physics/walk-policy.js
@@ -0,0 +1,27 @@
+// Selectable walking policy (URL ?walk=<key>). Whitelisted: no arbitrary paths.
+// All variants keep the 61D obs / 14D action / 50 Hz walking contract.
+// Genesis variants were trained on AMD GPUs with microduck-rl-genesis
+// (see experiments/s1_sim2sim for their MuJoCo sim2sim check).
+export const WALK_POLICIES = {
+  official: { file: "BEST_alpha_walking.onnx", label: "官方 Pollen (mjlab)" },
+  genesis: { file: "genesis/velocity.onnx", label: "Genesis velocity" },
+  "genesis-repro": { file: "genesis/velocity-reproduced.onnx", label: "Genesis velocity (复现)" },
+  "genesis-rough": { file: "genesis/rough.onnx", label: "Genesis rough" },
+  "genesis-backlash": { file: "genesis/backlash.onnx", label: "Genesis backlash" },
+  // walk v2: genesis velocity run + 3000 iterations (training/train_walk.py, walk-A):
+  // turning tracks commands closely; best match results with the Genesis football policy.
+  "genesis-v2": { file: "genesis/walk-A-5998.onnx", label: "Genesis walk v2" },
+  // fast gait (walk-E3): about 2x faster than v2 with the same turning/stopping precision;
+  // the game AI is tuned for slower robots, so it takes ~25% fewer shots (see training/MODELS.md).
+  "genesis-fast": { file: "genesis/walk-E3-10996.onnx", label: "Genesis fast (E3)" },
+};
+export const DEFAULT_WALK = "official";
+export function resolveWalkPolicy(key) {
+  const k = key || DEFAULT_WALK;
+  const policy = WALK_POLICIES[k];
+  if (!policy)
+    throw new Error(
+      `未知的行走模型 walk=${k}，可选：${Object.keys(WALK_POLICIES).join(", ")}`,
+    );
+  return { key: k, ...policy };
+}
