+++ b/src/physics/football-choice.js
@@ -0,0 +1,22 @@
+// Selectable ball-aware football policy (URL ?football=<key>). Whitelisted manifests only.
+// Every manifest still goes through runtime.js's contract validation (61D/14D,
+// 50/200 Hz, 4-step actuator delay, 1-step joint-velocity delay, 1.75 A).
+// The Genesis policy was trained on AMD GPUs (microduck-soccer-demo/training).
+export const FOOTBALL_POLICIES = {
+  official: { manifest: "football.json", label: "原作者 (mjlab)" },
+  genesis: { manifest: "genesis/football-v4ft-v3-2998.json", label: "Genesis v4ft-v3" },
+  // v5: trained with Genesis walking policies (walk-A / walk-D2) walking into the kick.
+  // Pair it with ?walk=genesis-v2: with the official walking policy it falls far more often.
+  "genesis-v5": { manifest: "genesis/football-v5-4497.json", label: "Genesis v5", requiresGenesisWalk: true },
+};
+export const DEFAULT_FOOTBALL = "official";
+export function resolveFootballPolicy(key) {
+  const k = key || DEFAULT_FOOTBALL;
+  const policy = FOOTBALL_POLICIES[k];
+  if (!policy)
+    throw new Error(
+      `未知的射门模型 football=${k}，可选：${Object.keys(FOOTBALL_POLICIES).join(", ")}`,
+    );
+  const dir = policy.manifest.includes("/") ? policy.manifest.replace(/[^/]+$/, "") : "";
+  return { key: k, dir, ...policy };
+}
