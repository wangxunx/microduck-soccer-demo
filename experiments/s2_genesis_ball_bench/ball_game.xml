<mujoco model="soccer_ball">
  <!-- Same ball as the soccer game (game/src/physics/world-core.js buildXml):
       radius 0.05 m, 30 g solid sphere, friction (sliding, torsional, rolling),
       solref .03 .4, condim 6. Genesis only imports friction[0] (sliding). -->
  <compiler angle="radian" autolimits="true"/>
  <worldbody>
    <body name="ball" pos="0.3 0 0.05">
      <freejoint name="ball_freejoint"/>
      <geom name="ball_geom" type="sphere" size="0.05" mass="0.03"
            friction=".4 .01 .003" solref=".03 .4" condim="6" contype="5" conaffinity="5"/>
    </body>
  </worldbody>
</mujoco>
